{
  "name": "co-coconut-company",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "smoke:production": "node scripts/production-smoke.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run test:frontend && npm --prefix packages/contracts test && npm --prefix backend test && npm --prefix infra test",
    "test:frontend": "tsx --test tests/phase-4-3/*.test.ts tests/phase-4-3/*.test.mjs",
    "backend:typecheck": "npm --prefix packages/contracts run typecheck && npm --prefix backend run typecheck",
    "infra:synth": "npm --prefix infra run synth",
    "aws:whoami": "AWS_PROFILE=dotco-console AWS_REGION=ap-south-1 node scripts/aws-whoami.mjs",
    "aws:dev:verify": "AWS_PROFILE=dotco-console AWS_REGION=ap-south-1 node scripts/aws-dev-verify.mjs",
    "infra:diff:dev": "cd infra && AWS_PROFILE=dotco-console AWS_REGION=ap-south-1 npx cdk diff",
    "infra:deploy:dev": "cd infra && AWS_PROFILE=dotco-console AWS_REGION=ap-south-1 npx cdk deploy",
    "start": "next start",
    "lint": "eslint .",
    "optimize:images": "node scripts/optimize-images.js",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:transparent": "node scripts/create-transparent-assets.mjs",
    "assets:map": "node scripts/build-website-asset-map.mjs",
    "media:audit": "node scripts/audit-public-assets.mjs",
    "media:upload": "node scripts/upload-media.mjs",
    "media:validate": "node scripts/validate-media.mjs",
    "media:find-local-references": "node scripts/find-local-media-references.mjs",
    "media:write-vercel-ignore": "node scripts/write-vercel-media-ignore.mjs",
    "favicons:generate": "node scripts/generate-favicons.mjs",
    "media:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/generate-media-library.ts",
    "media:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/sync-local-media-library.ts",
    "firestore:backup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/firestore-backup.ts",
    "firestore:restore": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/firestore-restore.ts",
    "firebase:bootstrap-admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/bootstrap-admin.ts",
    "firebase:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/firebase-audit.ts",
    "migrate:firebase:dry-run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/migrate-firebase.ts dry-run",
    "migrate:firebase:dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/migrate-firebase.ts dev",
    "verify:migration:dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/verify-migration.ts",
    "godaddy:dns:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/godaddy-dns-sync.ts",
    "godaddy:dns:apply": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/godaddy-dns-sync.ts --apply"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1085.0",
    "@dotco/contracts": "file:packages/contracts",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@types/three": "^0.184.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^11.18.2",
    "gsap": "^3.15.0",
    "jquery": "^3.7.1",
    "jquery.ripples": "^0.6.3",
    "lenis": "^1.3.25",
    "lucide-react": "^0.468.0",
    "next": "^15.5.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.79.0",
    "smooothy": "^0.0.35",
    "split-type": "^0.3.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.32",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "aws-cdk": "^2.1130.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.0",
    "typescript": "^5.5.3"
  }
}
