APP_ENV=local
AWS_REGION=ap-south-1
API_ALLOWED_ORIGINS=http://localhost:3000,https://cothecoconutcompany.com

# Cognito values generated by the environment's CDK stack.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_ISSUER=
COGNITO_REQUIRED_TOKEN_USE=access

# DynamoDB tables generated by the environment's CDK stack.
COMMERCE_TABLE_NAME=dotco-local-commerce
CONTENT_TABLE_NAME=dotco-local-content
AUDIT_TABLE_NAME=dotco-local-audit
RATE_LIMIT_TABLE_NAME=

# Never enable outside local automated tests.
ENABLE_AUTH_BYPASS_FOR_LOCAL_TESTS=false
